diff --git a/src/midi/ext-follow.ts b/src/midi/ext-follow.ts
index 14ab7316..ee08b8b2 100644
--- a/src/midi/ext-follow.ts
+++ b/src/midi/ext-follow.ts
@@ -30,11 +30,28 @@ const sent: number[] = new Array(EXT_KNOBS).fill(-1);
 const HOLD_MS = 350;
 const touchedMs: number[] = new Array(EXT_KNOBS).fill(0);
 
+/* RESYNC ON REST, NOT ON THE NEXT FRAME. twisterFollow runs per rendered
+ * frame, and an idle page renders none once the parameter stops moving — so a
+ * knob turned to its 127 end, with the parameter still at 70 %, was never
+ * resynced and could not take it further (seen on device). The last levels are
+ * kept, and twisterFollowRest (each tick) replays them once a hold expires. */
+const lastLevels: (number | null)[] = new Array(EXT_KNOBS).fill(null);
+let restDueMs = 0;
+
 /** A Twister knob (0-7) was just turned. */
 export function twisterTouched(knob: number, nowMs = Date.now()): void {
     if (knob < 0 || knob >= EXT_KNOBS) return;
     touchedMs[knob] = nowMs;
     sent[knob] = -1;    /* whatever it lands on is resent when it rests */
+    restDueMs = nowMs + HOLD_MS;
+}
+
+/** Each tick: a knob that has just come to rest gets its ring back, frame or
+ *  not. One compare when nothing is pending. */
+export function twisterFollowRest(nowMs = Date.now()): void {
+    if (!restDueMs || nowMs < restDueMs) return;
+    restDueMs = 0;
+    twisterFollow(lastLevels, nowMs);
 }
 
 /* The absolute decoder's origin setter, registered by midi/ext-knobs.ts at
@@ -60,8 +77,9 @@ export function twisterFollow(levels: readonly (number | null)[], nowMs = Date.n
     if (!armed) return;
     twisterColorSync();    /* the rings wear the active track's colour */
     for (let k = 0; k < EXT_KNOBS; k++) {
-        if (nowMs - touchedMs[k] < HOLD_MS) continue;
         const lv = levels[k];
+        if (levels !== lastLevels) lastLevels[k] = lv ?? null;
+        if (nowMs - touchedMs[k] < HOLD_MS) continue;
         if (lv === null || lv === undefined || !isFinite(lv)) continue;
         const v = Math.max(0, Math.min(127, Math.round(lv * 127)));
         if (sent[k] === v) continue;
diff --git a/src/midi/ext-param-steps.ts b/src/midi/ext-param-steps.ts
index f29b1abb..92ad128b 100644
--- a/src/midi/ext-param-steps.ts
+++ b/src/midi/ext-param-steps.ts
@@ -37,6 +37,16 @@ export function valueAt(info: StepInfo, n: number, pos: number): number {
     return info.type === 'enum' ? zone : Math.round(info.min) + zone;
 }
 
+/** A continuous parameter at ring position 0-127: the whole travel is the
+ *  whole range, linear like Schwung's knob level (normalizedOf), so the ring
+ *  the follow puts back (midi/ext-follow.ts) is exactly where it continues.
+ *  Relative steps were range/200 each — 128 of them crossed only 64 %. */
+export function continuousAt(info: StepInfo, pos: number): number {
+    const t = Math.max(0, Math.min(127, pos)) / 127;
+    const v = info.min + t * (info.max - info.min);
+    return info.type === 'int' ? Math.round(v) : v;
+}
+
 /** The string a module's set_param takes for `value`. */
 export function wireOf(info: StepInfo, value: number): string {
     if (info.type === 'enum') {
diff --git a/src/midi/ext-param.ts b/src/midi/ext-param.ts
index 68fc67d1..81399562 100644
--- a/src/midi/ext-param.ts
+++ b/src/midi/ext-param.ts
@@ -14,7 +14,7 @@ import { appState } from '../app/state.js';
 import { pageOwnerOf, type PageOwner, type PageRef } from '../app/page-owner.js';
 import { pageSourceFor } from '../renderer/schwung-grid.js';
 import { onMidiMessageInternal, knobModel } from './router.js';
-import { stepCount, valueAt, wireOf, type StepInfo } from './ext-param-steps.js';
+import { stepCount, valueAt, continuousAt, wireOf, type StepInfo } from './ext-param-steps.js';
 import { twisterTouched } from './ext-follow.js';
 import { mlog } from '../log.js';
 
@@ -51,23 +51,26 @@ function write(ref: PageRef, info: StepInfo & { ioKey: string }, value: number):
     appState.dirty = true;
 }
 
-/** A Twister knob turned: steps for a continuous parameter, the ring's
- *  position for a stepped one. */
+/** A Twister knob turned: the ring's position picks the value — a zone for a
+ *  stepped parameter, the matching point of the range for a continuous one.
+ *  Only a knob with no ranged parameter (the preset list) still steps. */
 export function extKnobTurn(knob: number, delta: number, pos: number): void {
     twisterTouched(knob);
     const owner = pageOwnerOf(knobModel());
     const info = owner.ref && owner.page ? owner.knobParamInfo(knob) : null;
     const n = stepCount(info);
-    if (!n || !owner.ref) {
+    const ranged = !!info && info.type !== 'enum' && isFinite(info.min) && isFinite(info.max)
+        && info.max > info.min;
+    if (!owner.ref || (!n && !ranged)) {
         onMidiMessageInternal([0xB0, MoveKnob1 + knob, delta >= 0 ? delta : 128 + delta]);
         return;
     }
     extBaseNote(owner, knob, info);
-    const v = valueAt(info, n, pos);
+    const v = n ? valueAt(info, n, pos) : continuousAt(info, pos);
     /* The page re-reads the value a few ticks later, so until then info.value
      * is the old one: without `zoneSent` every CC in between rewrote it. */
     const zone = idOf(owner.ref, info.ioKey) + '=' + v;
-    if (v === Math.round(info.value)) { zoneSent[knob] = ''; return; }
+    if (v === (n ? Math.round(info.value) : info.value)) { zoneSent[knob] = ''; return; }
     if (zoneSent[knob] === zone) return;
     zoneSent[knob] = zone;
     write(owner.ref, info, v);
