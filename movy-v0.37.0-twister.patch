+function extKnobCc(ch: number, d1: number, d2: number): void {
+    if (d1 >= EXT_REL_BASE && d1 < EXT_REL_BASE + EXT_KNOBS) {
+        if (d2 !== 0 && d2 !== 64) replay(MoveKnob1 + d1 - EXT_REL_BASE, d2);
+        return;
+    }
+    if (d1 >= EXT_ABS_BASE && d1 < EXT_ABS_BASE + EXT_KNOBS) {
+        const rel = absToRel('abs' + d1, d2);
+        if (rel) replay(MoveKnob1 + d1 - EXT_ABS_BASE, rel);
+        return;
+    }
+    if (ch === 2) {                      /* Twister encoder pushes */
+        const down = d2 > 0;
+        if (d1 === TW_JOG)    { replay(MoveMainButton, down ? 127 : 0); return; }
+        if (d1 === TW_BACK)   { replay(MoveBack, down ? 127 : 0); return; }
+        return;
+    }
+    if (ch !== 1) return;
+    if (d1 === TW_JOG) {
+        /* The Twister sends ~1 value per small step, the Move jog 1 per detent:
+         * gear it down so one jog step (one page) takes TW_JOG_STEPS of them. */
+        const rel = absToRel('tw' + d1, d2);
+        if (!rel) return;
+        jogAccum += rel < 64 ? rel : rel - 128;
+        while (jogAccum >= TW_JOG_STEPS)  { jogAccum -= TW_JOG_STEPS; replay(MoveMainKnob, 1); }
+        while (jogAccum <= -TW_JOG_STEPS) { jogAccum += TW_JOG_STEPS; replay(MoveMainKnob, 127); }
+        return;
+    }
