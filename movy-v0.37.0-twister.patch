+ *      (ext_route.rs) and cannot be kept out of the synth from here. */
+const EXT_REL_BASE = 71, EXT_ABS_BASE = 102, EXT_KNOBS = 8;
+const TW_KNOB_BASE = 8;            /* Twister CC 8-15 -> knobs 1-8 */
+const TW_JOG = 0, TW_PRESET = 2, TW_BACK = 3;
+const absLast = new Map<string, number>();
+const TW_JOG_STEPS = 10;
+let jogAccum = 0;
+let extCcLogged = 0;
+
+/* Absolute 0-127 -> a Move-format relative value (0 = no move). The first
+ * value seen on a control only sets its origin. */
+function absToRel(id: string, v: number): number {
+    const last = absLast.get(id);
+    absLast.set(id, v);
+    if (last === undefined) return 0;
+    const delta = Math.max(-63, Math.min(63, v - last));
+    return delta >= 0 ? delta : 128 + delta;
+}
