From 936c00a3552a3ec0a13ca02e979706e86e66acef Mon Sep 17 00:00:00 2001
From: rogerbacardit <rogerbacardit@gmail.com>
Date: Mon, 16 Nov 2026 17:51:44 +0100
Subject: [PATCH 2/2] MIDI IN: a menu turn marks the Set to be saved

Without it the channel lived until the next close: set-save writes the UI
blob only when something marked it dirty. Found on device (v0.37 backport).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 browser-test/logic/midi-in.mjs | 3 +++
 src/seq/track-menu.ts          | 5 ++++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/browser-test/logic/midi-in.mjs b/browser-test/logic/midi-in.mjs
index 19121600..09aff395 100644
--- a/browser-test/logic/midi-in.mjs
+++ b/browser-test/logic/midi-in.mjs
@@ -19,6 +19,7 @@ export async function run() {
     const mi = await import('../../dist/esm/track/midi-in.js');
     const { serializeUiState, applyUiState } = await import('../../dist/esm/seq/ui-state.js');
     const menu = await import('../../dist/esm/seq/track-menu.js');
+    const { takeUiDirty } = await import('../../dist/esm/seq/ui-dirty.js');
 
     const engine = installMockEngine();
     const reset = () => { resetSeqEngine(); resetSeqState(); resetStepRec(); resetSeqChord(); engine.reset(); mi.resetMidiIn(); };
@@ -76,7 +77,9 @@ export async function run() {
     menu.trackMenuKnob(1);
     eq('knob 1 on FREEZE changes nothing', mi.trackMidiIn(2), 0);
     menu.trackMenuJog(1);
+    takeUiDirty();
     menu.trackMenuKnob(1); menu.trackMenuKnob(1); menu.trackMenuKnob(1);
+    eq('a turn marks the Set to be saved', takeUiDirty(), true);
     const vm = menu.buildTrackMenuVM();
     eq('the MIDI IN row shows the channel', vm.rows[1].name + ' ' + vm.rows[1].value, 'MIDI IN CH 3');
     eq('and is the selected row', vm.selected, 1);
diff --git a/src/seq/track-menu.ts b/src/seq/track-menu.ts
index 7df5f822..06b30caa 100644
--- a/src/seq/track-menu.ts
+++ b/src/seq/track-menu.ts
@@ -12,6 +12,7 @@ import { seqState } from './state.js';
 import { isFrozen, freezeConfirm } from './freeze.js';
 import type { FlagsPageVM } from './flags-page-vm.js';
 import { midiInLabel, stepTrackMidiIn, trackMidiIn } from '../track/midi-in.js';
+import { markUiStateDirty } from './ui-dirty.js';
 
 export const ROW_FREEZE = 0;
 export const ROW_MIDI_IN = 1;
@@ -46,7 +47,9 @@ export function trackMenuJog(dir: number): void {
 
 /** Knob 1 on the MIDI IN row steps the channel. */
 export function trackMenuKnob(dir: number): void {
-    if (state.track >= 0 && state.row === ROW_MIDI_IN && dir !== 0) stepTrackMidiIn(state.track, dir);
+    if (state.track < 0 || state.row !== ROW_MIDI_IN || dir === 0) return;
+    stepTrackMidiIn(state.track, dir);
+    markUiStateDirty();   // the Set saves it (seq/set-save.ts), or it is gone on close
 }
 
 export function closeTrackMenu(): void {
-- 
